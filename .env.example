# Local Postgres. Adjust the user if yours differs.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/f1_race_prediction
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/f1_race_prediction_test

# FastF1 caches every network fetch here. Essential -- without it every
# re-run re-downloads session data.
FASTF1_CACHE_DIR=data/fastf1_cache

LOG_LEVEL=INFO
